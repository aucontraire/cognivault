#!/bin/sh

echo "🔧 Pre-commit hook: Running code formatter..."
make format
status=$?

if [ $status -ne 0 ]; then
  echo "❌ Formatting failed. Commit aborted."
  exit 1
fi

echo "✅ Formatting complete. Proceeding with type check..."

echo "🚧 Pre-commit hook: Running type checks..."
make typecheck
if [ $? -ne 0 ]; then
  echo "❌ Type check failed. Commit aborted."
  exit 1
fi

echo "✅ Type check complete. Proceeding with commit."

echo "🗂️  Pre-commit hook: Regenerating class registry..."
if poetry run python .claude/tools/generate_class_registry.py --include-tests >/dev/null 2>&1; then
  echo "✅ Class registry regenerated."
else
  echo "⚠️  Class registry regeneration failed (non-blocking) — run 'poetry run python .claude/tools/generate_class_registry.py --include-tests' manually."
fi

exit 0